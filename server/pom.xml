<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.example</groupId>
        <artifactId>home-docs-registrar</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>home-docs-server</artifactId>
    <name>home-docs-server</name>
    <description>VPS side: Telegram bot, OCR, Postgres registry, retrieval by file_id, backup API</description>

    <properties>
        <telegrambots.version>9.0.0</telegrambots.version>
        <anthropic-java.version>2.34.0</anthropic-java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Telegram: plain libraries (no Spring starter) — proven on Spring Boot 4 in the sibling
             Notifier project. telegrambots-client = typed API calls, -longpolling = the polling runner. -->
        <dependency>
            <groupId>org.telegram</groupId>
            <artifactId>telegrambots-longpolling</artifactId>
            <version>${telegrambots.version}</version>
        </dependency>
        <dependency>
            <groupId>org.telegram</groupId>
            <artifactId>telegrambots-client</artifactId>
            <version>${telegrambots.version}</version>
        </dependency>

        <!-- Vision extraction: official Anthropic SDK (Claude Haiku 4.5) reads the document image and
             returns structured fields. Will replace the local Tesseract/ImageMagick OCR path. -->
        <dependency>
            <groupId>com.anthropic</groupId>
            <artifactId>anthropic-java</artifactId>
            <version>${anthropic-java.version}</version>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway owns the Postgres schema: a baseline (V1) plus the FTS migration (V2 = generated
             tsvector column + GIN index). The STARTER is required — in Spring Boot 4 the Flyway
             auto-configuration lives in the spring-boot-flyway module (raw flyway-core alone does NOT
             auto-run migrations). flyway-database-postgresql is needed for Postgres. Disabled for the
             H2 tests (Postgres-specific SQL) — there Hibernate builds the schema. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- In-memory DB for tests only, so @SpringBootTest boots without a real Postgres.
             Postgres-specific FTS is implemented against real Postgres (step 3), not exercised here. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
